# Zemax 连接配置
# 说明：MCP 模式下 LLM 由客户端（VS Code Copilot / Claude Desktop）提供，
#       本服务器不需要任何 API Key，因此这里没有 LLM 配置项。

# 连接模式
#   extension : 连接到已运行的 OpticStudio（推荐，需先在 Zemax 中点击 Programming → Interactive Extension）
#   standalone: 让 Python 直接启动一个新的 OpticStudio 实例
ZEMAX_MODE=extension

# Extension 实例编号（通常为 0）
ZEMAX_INSTANCE=0
